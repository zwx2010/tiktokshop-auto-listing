# ── Python ────────────────────────────────────────────────
__pycache__/
*.pyc
docs/demo/frames/

# ── 敏感配置（含飞书 app_secret / verification_token，绝不上传）──
config/*.local.json

# ── 易变数据（机器学习的、随采集增长的）──
config/upload_learning.json

# ── 业务数据 + 日志 + 导出（SQLite 频繁变动，是业务数据不是代码）──
data/
*.log
*.bak

# ── 外部二进制工具 ─────────────────────────────────────────
cpolar-bin/

# ── 临时 / 导出产物 ────────────────────────────────────────
*.xlsx

# ── 杂项垃圾目录（临时截图等）──────────────────────────────
新建文件夹/

# ── 个人环境配置（Claude Code 本机权限/路径，不进仓库）─────
.claude/
